{
  "expo": {
    "name": "Delivery Tamem",
    "slug": "tamem-delivery",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "scheme": "tamem",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tamem.delivery",
      "buildNumber": "30",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك عشان نحدد عنوان التوصيل بدقة ونوصّل لك الطلب بسرعة.",
        "NSCameraUsageDescription": "نحتاج الكاميرا عشان تصوّر طلبك أو الروشتة وترفقها مع الطلب.",
        "NSPhotoLibraryUsageDescription": "نحتاج الصور عشان ترفق صورة لطلبك أو تغيّر صورة حسابك.",
        "NSPhotoLibraryAddUsageDescription": "عشان نحفظ صورة إيصال الطلب في ألبوم صورك.",
        "NSMicrophoneUsageDescription": "نحتاج الميكروفون عشان تسجّل طلبك بصوتك بدل ما تكتبه.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tamem.delivery",
      "versionCode": 30,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon.png",
        "backgroundColor": "#E0301E"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icon.png",
          "color": "#E0301E",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-font",
      "expo-localization",
      "expo-web-browser"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/icon.png"
    },
    "extra": {
      "forceRTL": true,
      "eas": {
        "projectId": "1d399315-69df-4baf-b6e5-f5d41e65f3e9"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "delivery-tamem"
  }
}
